# Entries follow https://github.com/github/gitignore/blob/main/Python.gitignore,
# limited to the tools this project uses.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Environments
.venv/
.env
.env.*
!.env.example

# Ruff stuff
.ruff_cache/

# PyPI configuration file
.pypirc

# Editors
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Operating system metadata
.DS_Store
._*
Thumbs.db
[Dd]esktop.ini
.directory
